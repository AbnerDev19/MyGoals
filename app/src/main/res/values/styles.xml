<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand_purple">#6657F5</color>
    <color name="screen_background">#F5F6FC</color>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_purple</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/screen_background</item>
    </style>
</resources>
